# Copy to .env.local for local development.

# services/core's REST API (see `make serve`)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Placeholder auth for Phase 1 (see app/api/deps.py): a fixed tenant id sent as the
# X-Tenant-Id header on every request. Defaults to the seed script's demo tenant
# (services/core/app/seed.py) if unset. Real OAuth 2.1 sessions are Phase 2.
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-0000000000d0
